# ???¤í…Œ?´ì???VS?ì„œ ë¹ ë¥¸ ëª¨ë“œë¡??¤í–‰?????¬ìš©?©ë‹ˆ???”ë²„ê·?êµ¬ì„±??ê¸°ë³¸ê°?.
FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS base
USER $APP_UID
WORKDIR /app
EXPOSE 8080


# ???¤í…Œ?´ì????œë¹„???„ë¡œ?íŠ¸ë¥?ë¹Œë“œ?˜ëŠ” ???¬ìš©?©ë‹ˆ??
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
ARG BUILD_CONFIGURATION=Release
WORKDIR /src
COPY ["WAS.csproj", "."]
RUN dotnet restore "./WAS.csproj"
COPY . .
WORKDIR "/src/."
RUN dotnet build "./WAS.csproj" -c $BUILD_CONFIGURATION -o /app/build

# ???¤í…Œ?´ì???ìµœì¢… ?¤í…Œ?´ì???ë³µì‚¬???œë¹„???„ë¡œ?íŠ¸ë¥?ê²Œì‹œ?˜ëŠ” ???¬ìš©?©ë‹ˆ??
FROM build AS publish
ARG BUILD_CONFIGURATION=Release
RUN dotnet publish "./WAS.csproj" -c $BUILD_CONFIGURATION -o /app/publish /p:UseAppHost=false

# ???¤í…Œ?´ì????„ë¡œ?•ì…˜?ì„œ ?¬ìš©?˜ê±°??VS?ì„œ ?¼ë°˜ ëª¨ë“œë¡??¤í–‰?????¬ìš©?©ë‹ˆ???”ë²„ê·?êµ¬ì„±???¬ìš©?˜ì? ?ŠëŠ” ê²½ìš° ê¸°ë³¸ê°?.
FROM base AS final
WORKDIR /app
COPY --from=publish /app/publish .
ENTRYPOINT ["dotnet", "WAS.dll"]
