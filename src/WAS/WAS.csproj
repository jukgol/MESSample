<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>.</DockerfileContext>    
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.72" />
    <PackageReference Include="dbup-oracle" Version="6.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.*" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.22.1" />
    <PackageReference Include="Oracle.ManagedDataAccess.Core" Version="23.26.200" />        
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.17.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\Scripts\Migrations\*.sql" />
    <ProjectReference Include="..\Shared\Shared.csproj" />
    <None Update="Data\Scripts\**\*.sql">     
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="GenerateSwagger" AfterTargets="Build">
    <MakeDir Directories="../api" Condition="!Exists('../api')" />
    <Exec Command="chcp 65001 > nul &amp;&amp; dotnet tool run swagger tofile --output ../api/swagger.json $(OutputPath)$(AssemblyName).dll v1" />
  </Target>
</Project>
