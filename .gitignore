## [Visual Studio]
## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## See https://raw.githubusercontent.com/github/gitignore/main/VisualStudio.gitignore

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
/src/api/swagger.json

# Visual Studio 2015/2017/2019/2022 cache/options directory
.vs/
# Uncomment if you use Visual Studio Code
.vscode/

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (DotSettings)
*.DotSettings.user

# Project backup files
*.bak
*.cache
*.csproj.user
*.resharper.user
*.redir

# Microsoft Azure Build Output
csx/
*.build.csdef

# Microsoft Azure Cloud Service projects
ecf/
rcf/

# SQL Server files
*.mdf
*.ldf
*.ndf

# Other temporary files
*.tmp
*.temp

# NuGet Packages
*.nupkg
# The packages folder can be ignored because of Package Restore
**/[Pp]ackages/*
# except build/, which is used as an MSBuild target.
!**/[Pp]ackages/build/
# Uncomment if using NuGet repositories to store project-specific packages
# !**/[Pp]ackages/

# NuGet Restore MSBuild targets
*.nuget.targets
*.nuget.props

# MSBuild
[Bb]in/
[Oo]bj/

# Docker
.dockerignore

# Environment files
.env
.env.*

# OS files
.DS_Store
Thumbs.db

# User preference files
*.swp
*.swo

# Project files (Excluded by user request - Not recommended for collaboration)
*.sln

# CSV Export data directory
src/tabledata/
